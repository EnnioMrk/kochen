# Core
APP_ORIGIN=https://rezepte.ennio.vip
CANONICAL_HOST=rezepte.ennio.vip
DATABASE_URL=postgres://kochen:kochen@localhost:5432/kochen
PORT=3000
LOG_LEVEL=info
# Platform auth
ENNIO_JWKS_URL=https://api.ennio.vip/v1/.well-known/jwks.json
ENNIO_AUD=kochen
# Dev only: allow a local bearer token "dev:<sub>:<email>:<name>" when true
DEV_AUTH=false
# Media (Cloudflare R2, S3 compatible)
R2_ENDPOINT=
R2_BUCKET=kochen
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Local disk fallback when R2 is empty. Mount a shared volume here.
MEDIA_DIR=/data/media
MEDIA_SECRET=change-me
# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_EXTRACTION_MODEL=gemini-2.0-flash
AI_TEXT_MODEL=gemini-2.0-flash
# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ennio.vip
